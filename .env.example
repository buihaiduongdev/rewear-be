# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5000

# Rate limit
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Database
# DATABASE_URL=postgresql://username:password@host:5432/rewear
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rewear

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRATION=30d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=RE.WEAR <no-reply@example.com>
FRONTEND_URL=http://localhost:5000

# AI (Gemini)
# API_KEY can be omitted when AI generation is not used.
API_KEY=your-gemini-api-key
API_MODEL=your-gemini-model-id

# Storage (Cloudflare R2)
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
STORAGE_BUCKET=rewear
STORAGE_PUBLIC_BASE_URL=https://media.example.com
# Upload ticket lifetime in seconds
STORAGE_EXPIRES_IN=900
