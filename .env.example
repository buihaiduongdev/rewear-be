# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5000

# Rate limit
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Database
# DATABASE_URL=postgresql://username:password@host:5432/rewear
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rewear

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRATION=30d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=RE.WEAR <no-reply@example.com>
FRONTEND_URL=http://localhost:5000

# Object storage (Cloudflare R2 or another S3-compatible service)
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
STORAGE_BUCKET=rewear-media
STORAGE_PUBLIC_BASE_URL=https://media.example.com
STORAGE_MAX_SIZE_BYTES=10485760
STORAGE_UPLOAD_EXPIRES_IN_SECONDS=900
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif
