# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5000

# Rate limit
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Database
# DATABASE_URL=postgresql://username:password@host:5432/rewear
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rewear
DB_SSL=false

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRATION=30d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=RE.WEAR <no-reply@example.com>
FRONTEND_URL=http://localhost:5000

# Object storage (Cloudflare R2 or another S3-compatible service)
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
STORAGE_BUCKET=rewear-media
STORAGE_PUBLIC_BASE_URL=https://media.example.com
STORAGE_MAX_SIZE_BYTES=10485760
STORAGE_UPLOAD_EXPIRES_IN_SECONDS=900
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif

# Optional staging-only shipping estimates (never production booking)
GHN_SANDBOX_ENABLED=false
GHN_BOOKING_ENABLED=false
# GHN_SANDBOX_TOKEN=your-server-only-staging-token
# GHN_SANDBOX_SHOP_ID=your-staging-shop-id

# Optional PayOS VietQR gateway (disabled until credentials are ready)
PAYOS_ENABLED=false
# PAYOS_CLIENT_ID=your-payos-client-id
# PAYOS_API_KEY=your-payos-api-key
# PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# PAYOS_RETURN_URL=https://your-frontend.example/payment-result
# PAYOS_CANCEL_URL=https://your-frontend.example/payment-cancel
# PAYOS_TIMEOUT_MS=30000

# Separate PRIVATE bucket for dispute evidence; never use STORAGE_BUCKET.
# Operator must disable public access and configure authenticated browser PUT/GET CORS.
STORAGE_PRIVATE_BUCKET=rewear-private
