@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #2C3E50

|#E9F7EF|Người bán|
|#FEF9E7|Hệ thống sàn|
|#EAF2F8|Người mua|

|Người bán|
start
:Nhận thông báo đơn hàng mới "Chờ xác nhận";

if (Khả năng chuẩn bị hàng?) then (Từ chối / Quá 24 giờ [Quy tắc 5])
  :Bấm Hủy đơn;
  |Hệ thống sàn|
  :Đơn hàng = "Đã hủy";
  :Hoàn tiền cho khách (nếu đã trả trước);
  :Món đồ = "Đang bán" (Nhả lại kho);
  stop
else (Đồng ý bán)
  |Người bán|
  :Bấm "Xác nhận & Chuẩn bị hàng";
  |Hệ thống sàn|
  :Đơn hàng = "Đang chuẩn bị hàng";
  :Món đồ chuyển: Đang giữ -> "Đã bán" [Quy tắc 1];
  
  |Người bán|
  :Đóng gói và đem gửi bưu cục;
  :Nhập mã vận đơn bưu phẩm vào hệ thống;
  |Hệ thống sàn|
  :Đơn hàng = "Đang giao hàng";
  
  |Người bán|
  :Tải ảnh biên lai bưu cục & bấm "Đã giao hàng" [Quy tắc 3];
  |Hệ thống sàn|
  :Đơn hàng = "Đã giao hàng";
  :Kích hoạt đếm ngược 3 ngày khiếu nại [Quy tắc 4];
  
  |Người mua|
  if (Kiểm tra món đồ nhận được?) then (Hài lòng / Quá 3 ngày không khiếu nại)
    |Người mua|
    :Bấm "Đã nhận được hàng";
    |Hệ thống sàn|
    :Đơn hàng = "Hoàn tất";
    :Cộng tiền bán vào số dư tài khoản Người bán;
    stop
  else (Món đồ bị lỗi / Rách / Khác mô tả)
    |Người mua|
    :Bấm "Khiếu nại" kèm video ảnh bằng chứng [Quy tắc 4];
    |Hệ thống sàn|
    :Đơn hàng = "Đang khiếu nại";
    :Đóng băng tiền thanh toán để chờ giải quyết;
    stop
  endif
endif
@enduml