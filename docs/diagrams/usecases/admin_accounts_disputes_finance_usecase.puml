@startuml Hinh3_13_LuocDo_Admin_PhanXu_TaiChinh
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
}

actor "Quản trị viên\n(Admin)" as Admin
actor "Cổng thanh toán" as CongThanhToan

rectangle "Phân hệ Quản trị Người dùng & Tài chính" {
  usecase "Quản lý người dùng sàn" as QuanLyNguoiDung
  usecase "Khóa tài khoản vi phạm" as KhoaTK
  usecase "Mở khóa tài khoản" as MoKhoaTK
  
  usecase "Giải quyết khiếu nại tranh chấp" as GiaiQuyetKhieuNai
  usecase "Xem đối chiếu video mở hộp & ảnh thật" as XemDoiChieu
  usecase "Bác bỏ khiếu nại (Giải ngân cho shop)" as BacBoKhieuNai
  usecase "Chấp nhận khiếu nại (Hoàn tiền)" as ChapNhanKhieuNai
  usecase "Gọi lệnh hoàn tiền tự động qua cổng" as GoiHoanTien
  
  usecase "Tra cứu đơn hàng toàn sàn" as TraCuuDonToanSan
  usecase "Đối soát giao dịch thanh toán trực tuyến" as DoiSoatThanhToan
  
  usecase "Xem dashboard thống kê sàn" as XemThongKe
  usecase "Tra cứu nhật ký kiểm toán (Audit Log)" as TraCuuLog
}

Admin --> QuanLyNguoiDung
Admin --> GiaiQuyetKhieuNai
Admin --> TraCuuDonToanSan
Admin --> XemThongKe
Admin --> TraCuuLog

KhoaTK ..> QuanLyNguoiDung : <<extend>>
MoKhoaTK ..> QuanLyNguoiDung : <<extend>>

GiaiQuyetKhieuNai ..> XemDoiChieu : <<include>>
BacBoKhieuNai ..> GiaiQuyetKhieuNai : <<extend>>
ChapNhanKhieuNai ..> GiaiQuyetKhieuNai : <<extend>>
ChapNhanKhieuNai ..> GoiHoanTien : <<include>>

DoiSoatThanhToan ..> TraCuuDonToanSan : <<extend>>

GoiHoanTien -- CongThanhToan
DoiSoatThanhToan -- CongThanhToan
@enduml